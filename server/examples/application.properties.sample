# Copy to config/application.properties on the deployment machine, then replace
# every REPLACE_ value. Never commit or distribute the active file with secrets.

quarkus.datasource.jdbc.url=jdbc:postgresql://localhost:5432/dashboard
quarkus.datasource.username=dashboard
quarkus.datasource.password=REPLACE_DATABASE_PASSWORD

dashboard.token-key=REPLACE_SAVED_TOKEN_KEY
dashboard.ui-base-path=/
dashboard.ui-config-file=config/config.json
dashboard.media-directory=C:/dashboard-data/media
dashboard.zone=Europe/Vienna

# Optional integrations; configure private upstreams here, not in public config.json.
# dashboard.proxy.openhab-url=http://openhab.example.lan:8080
# dashboard.proxy.openhab-token=REPLACE_OPENHAB_TOKEN
# dashboard.proxy.go2rtc-url=http://127.0.0.1:1984

dashboard.microsoft.client-id=REPLACE_MICROSOFT_CLIENT_ID
dashboard.microsoft.client-secret=REPLACE_MICROSOFT_CLIENT_SECRET_VALUE
dashboard.microsoft.redirect-uri=https://dashboard.home.arpa/api/accounts/callback

quarkus.http.host=127.0.0.1
quarkus.http.port=8080
quarkus.http.proxy.proxy-address-forwarding=true
quarkus.http.proxy.allow-forwarded=false
quarkus.http.proxy.allow-x-forwarded=true
quarkus.http.proxy.trusted-proxies=127.0.0.1,::1

# Keycloak bearer tokens; the dashboard client role admin authorizes changes.
quarkus.oidc.auth-server-url=https://login.home.arpa/realms/dashboard
quarkus.oidc.token.audience=dashboard