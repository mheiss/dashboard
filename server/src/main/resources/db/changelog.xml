<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <include file="baseline.xml" relativeToChangelogFile="true"/>
    <changeSet id="photo-dimensions" author="dashboard">
        <addColumn tableName="photo">
            <column name="width" type="INT"/>
            <column name="height" type="INT"/>
        </addColumn>
    </changeSet>
    <changeSet id="source-sync-details" author="dashboard">
        <addColumn tableName="source">
            <column name="sync_status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="sync_error" type="${textType}"/>
            <column name="sync_last_sync" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="file_count" type="INT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>