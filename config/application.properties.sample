# Copy to config/application.properties on the deployment machine, then replace
# every REPLACE_ value. Never commit or distribute the active file with secrets.

# Quarkus configuration
quarkus.http.host=127.0.0.1
quarkus.http.port=8080

# Database configuration
quarkus.datasource.jdbc.url=jdbc:postgresql://localhost:5432/dashboard
quarkus.datasource.username=dashboard
quarkus.datasource.password=REPLACE_DATABASE_PASSWORD

# Dashboard configuration
dashboard.token-key=REPLACE_SAVED_TOKEN_KEY
dashboard.media-directory=C:/dashboard-data/media
dashboard.zone=Europe/Vienna

# Microsoft authentication
dashboard.microsoft.client-id=REPLACE_MICROSOFT_CLIENT_ID
dashboard.microsoft.client-secret=REPLACE_MICROSOFT_CLIENT_SECRET_VALUE
dashboard.microsoft.redirect-uri=https://dashboard.home.arpa/api/accounts/callback

# Keycloak authentication
quarkus.oidc.auth-server-url=https://login.home.arpa/realms/dashboard
quarkus.oidc.token.audience=dashboard

# (Optional) OpenHAB integration
# dashboard.openhab.sitemap=https://openhab.home.arpa/basicui/app
# dashboard.openhab.items.security=Security
# dashboard.openhab.items.pin=Security_Pin
# dashboard.openhab.items.doorbell=Entrance_Bell_Switch
# dashboard.openhab.doorbell-camera=entry
# dashboard.proxy.openhab-url=http://localhost:8082
# dashboard.proxy.openhab-token=REPLACE_OPENHAB_TOKEN

# (Optional) EVCC integration
# dashboard.evcc.url=https://evcc.home.arpa

# (Optional) UniFi Protect integration
# dashboard.proxy.go2rtc-url=http://localhost:1984
# dashboard.protect.cameras[0].id=entry
# dashboard.protect.cameras[0].label=Eingang
# dashboard.protect.cameras[1].id=garden
# dashboard.protect.cameras[1].label=Garten
# dashboard.protect.cameras[2].id=patio
# dashboard.protect.cameras[2].label=Terrasse

# (Optional) Logging configuration
# quarkus.log.file.enabled=true
# quarkus.log.console.enabled=false
# quarkus.log.file.path=/var/log/dashboard/app.log
# quarkus.log.file.rotation.max-file-size=10M
# quarkus.log.file.rotation.max-backup-index=5

# (Optional) Quarkus behind a reverse Proxy (e.g: Traefik)
# quarkus.http.proxy.proxy-address-forwarding=true
# quarkus.http.proxy.allow-forwarded=false
# quarkus.http.proxy.allow-x-forwarded=true
# quarkus.http.proxy.enable-forwarded-host=true
# quarkus.http.proxy.trusted-proxies=traefik.home.arpa,::1
